# Database Configuration
DATABASE_URL=postgresql://netsentinel:secure_password_123@localhost:5432/netsentinel_db
DB_USER=netsentinel
DB_PASSWORD=secure_password_123
DB_NAME=netsentinel_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security & Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=admin@netsentinel.local
ADMIN_PASSWORD=admin123456

# Server Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8001
VITE_API_URL=http://127.0.0.1:8001

# ML/Detection Configuration
ANOMALY_THRESHOLD=0.7
MODEL_VERSION=v1.0.0

# External Services (Optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=

# Kafka Configuration (Optional)
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=network-flows

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sentry/Error Tracking (Optional)
SENTRY_DSN=
